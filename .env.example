# Prise Shelly pilotant la lampe de croissance
SHELLY_HOST=192.168.1.102
SHELLY_SWITCH_ID=0

# Publication du tableau de bord
# 0.0.0.0 = accessible depuis tout le reseau local (telephone compris)
# 127.0.0.1 = accessible uniquement depuis la machine
BIND_ADDR=0.0.0.0
PORT=8080

# Prix du kWh TTC : valeur INITIALE seulement. Une fois regle depuis la page
# Parametres, c'est la valeur en base qui fait foi.
PRICE_PER_KWH=0.2016

# Fuseau des horaires saisis dans l'interface. Le conteneur tourne en UTC :
# sans ce reglage, toutes les decisions horaires du serveur sont decalees.
LOCAL_TZ=Europe/Paris
